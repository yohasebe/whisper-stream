# Function to get the name of the current audio input device on macOS
function get_macos_input_device() {
  # if SwitchAudioSource command available
  if [ -x "$(command -v SwitchAudioSource)" ]; then
    local input_device=$(SwitchAudioSource -t input -c)
    echo "$input_device"
    return
  fi
}

# Function to get the volume of the audio input on macOS
function get_macos_input_volume() {
  local input_volume=$(osascript -e "input volume of (get volume settings)")
  echo "$input_volume%"
}

# Function to get the name of the current audio input device on Linux
function get_linux_input_device() {
  # if arecord command available
  if [ -x "$(command -v arecord)" ]; then
    local input_device=$(arecord -l | grep -oP "(?<=card )\d+(?=:\s.*\[)")
    echo "hw:$input_device"
    return
  fi
}

function get_linux_input_volume() {
  # Check if amixer command is available and executable
  if [ -x "$(command -v amixer)" ]; then
    local input_volume=$(amixer sget Capture | grep 'Left:' | awk -F'[][]' '{ print $2 }')
    echo "$input_volume"
    return
  fi
}

# Function to display current settings
function display_settings() {
  if [ "$QUIET_MODE" = true ]; then
    return
  fi

  echo ""
  echo $'\e[1;34m'Whisper Stream Speech-to-Text Transcriber$'\e[0m' ${VERSION}
  echo $'\e[1;33m'-----------------------------------------------$'\e[0m'
  echo "Current settings:"
  echo "  Backend: $BACKEND"
  if [ "$BACKEND" = "local" ]; then
    echo "  Model: $(basename "$MODEL_PATH")"
  else
    echo "  Model: $MODEL"
  fi
  if [ "$BACKEND" = "api" ] && [ -n "$API_URL" ]; then
    echo "  API URL: $API_URL"
  fi
  echo "  Volume threshold: $MIN_VOLUME"
  echo "  Silence length: $SILENCE_LENGTH seconds"
  echo "  Input language: ${LANGUAGE:-Not specified}"
  if [ ${#KEYWORDS[@]} -gt 0 ]; then
    echo "  Keywords: ${#KEYWORDS[@]}"
  fi

  if [ -n "$TRANSLATE" ]; then
    echo "  Translate to English: $TRANSLATE"
  fi

  if [ "$DIARIZE" = true ]; then
    echo "  Diarization: enabled"
    if [ ${#KNOWN_SPEAKERS[@]} -gt 0 ]; then
      local speakers_json="$SPEAKER_DIR/speakers.json"
      echo "  Known speakers:"
      for speaker_key in "${KNOWN_SPEAKERS[@]}"; do
        local speaker_name
        speaker_name=$(jq -r --arg k "$speaker_key" '.[$k].name' "$speakers_json" 2>/dev/null)
        if [ -n "$speaker_name" ] && [ "$speaker_name" != "null" ]; then
          echo "    - $speaker_name"
        fi
      done
    fi
  fi

  if [ -n "$OUTPUT_DIR" ]; then
    echo "  Output Dir: $OUTPUT_DIR"
  fi

  # Get the input device based on the operating system
  local input_device=$(get_input_device)
  if [ -n "$input_device" ]; then
    echo "  Input device: $input_device"
  fi

  # Get the input volume based on the operating system
  local input_volume=$(get_input_volume)
  if [ -n "$input_volume" ]; then
    echo "  Input volume: $input_volume"
  fi

  echo $'\e[1;33m'-----------------------------------------------$'\e[0m'
  echo To stop the app, press $'\e[0;36m'Ctrl+C$'\e[0m'
  echo ""
}

# Get the name of the current audio input device based on OS
function get_input_device() {
  case "$(uname)" in
    Darwin)
      get_macos_input_device
      ;;
    Linux)
      get_linux_input_device
      ;;
    *)
      echo "Unknown operating system"
      ;;
  esac
}

# Get the volume level of the current audio input device based on OS
function get_input_volume() {
  case "$(uname)" in
    Darwin)
      get_macos_input_volume
      ;;
    Linux)
      get_linux_input_volume
      ;;
    *)
      echo "Unknown operating system"
      ;;
  esac
}

# Number of recorded utterances in directory $1 (output_<seq>.mp3 files).
function count_utterances() {
  local -a files=("$1"/output_*.mp3)
  if [ -e "${files[0]}" ]; then
    echo "${#files[@]}"
  else
    echo 0
  fi
}

# Real-time mode: transcribe the utterances the main loop leaves in
# $QUEUE_DIR, in capture order, with at most $1 running at once. Each file
# moves to $ACTIVE_DIR while its worker runs, and convert_audio_to_text
# removes it. Runs in the background so recording never waits for the API.
# Once $WORK_DIR/stop exists it finishes the queue and exits; it exits at
# once if the main shell is gone. Draws the spinner while workers run.
function dispatch_utterances() {
  local max_jobs=$1
  local -a running=() still=() queued=()
  local pid file name seq spinner=false spun=false frames='|/-\' frame=0
  if [ "$STDOUT_MODE" = false ] && [ -t 1 ]; then
    spinner=true
  fi
  local stopping=false
  while true; do
    # Look for the stop request BEFORE looking at the queue: the main shell
    # creates it only after its last `mv` into the queue, so once it is seen,
    # the queue checked below holds every utterance there will be.
    [ -e "$WORK_DIR/stop" ] && stopping=true

    still=()
    for pid in "${running[@]}"; do
      if kill -0 "$pid" 2>/dev/null; then
        still+=("$pid")
      else
        # Collect the status; one failed utterance never stops the session.
        wait "$pid" 2>/dev/null || true
      fi
    done
    running=("${still[@]}")

    queued=("$QUEUE_DIR"/output_*.mp3)
    for file in "${queued[@]}"; do
      [ -e "$file" ] || break
      [ ${#running[@]} -lt "$max_jobs" ] || break
      name=$(basename "$file")
      if ! mv "$file" "$ACTIVE_DIR/$name"; then
        echo "Warning: could not start transcribing $name; skipping it" >&2
        rm -f "$file"
        continue
      fi
      seq=${name#output_}
      seq=$((10#${seq%.mp3}))
      convert_audio_to_text "$ACTIVE_DIR/$name" "$seq" &
      running+=("$!")
    done

    if [ "$stopping" = true ] && [ ${#running[@]} -eq 0 ] \
       && [ "$(count_utterances "$QUEUE_DIR")" -eq 0 ]; then
      break
    fi
    kill -0 $$ 2>/dev/null || break

    if [ "$spinner" = true ]; then
      if [ ${#running[@]} -gt 0 ]; then
        printf "\r\e[1;31m%s\e[0m" "${frames:$frame:1}"
        frame=$(((frame + 1) % 4))
        spun=true
      elif [ "$spun" = true ]; then
        printf "\r\e[K"
        spun=false
      fi
    fi
    sleep 0.1
  done
  if [ "$spun" = true ]; then
    printf "\r\e[K"
  fi
}

# Called before each recording. Blocks while MAX_QUEUE utterances are
# waiting, so a long API outage cannot fill the disk. Returns non-zero if the
# dispatcher has died: nothing would transcribe what is recorded next.
function wait_for_queue_space() {
  local paused=false
  kill -0 "$DISPATCHER_PID" 2>/dev/null || return 1
  while [ "$(count_utterances "$QUEUE_DIR")" -ge "$MAX_QUEUE" ]; do
    if ! kill -0 "$DISPATCHER_PID" 2>/dev/null; then
      return 1
    fi
    if [ "$paused" = false ]; then
      echo "Warning: $MAX_QUEUE utterances are waiting for transcription; recording paused" >&2
      paused=true
    fi
    sleep 0.5
  done
  if [ "$paused" = true ]; then
    echo "Recording resumed" >&2
  fi
  return 0
}

# Kill process $1 and all its descendants. Each process is stopped before
# its children are listed, so no process in the tree can start one that is
# missed, and the whole tree is collected before any kill: killing a parent
# first would orphan its children out of reach. Processes that survive
# SIGTERM for 2 s get SIGKILL.
function kill_process_tree() {
  local -a pids=("$1") alive=()
  local i=0 pid child tries=0
  while [ $i -lt ${#pids[@]} ]; do
    kill -STOP "${pids[$i]}" 2>/dev/null
    for child in $(pgrep -P "${pids[$i]}" 2>/dev/null); do
      pids+=("$child")
    done
    i=$((i + 1))
  done
  kill -TERM "${pids[@]}" 2>/dev/null
  kill -CONT "${pids[@]}" 2>/dev/null
  while true; do
    alive=()
    for pid in "${pids[@]}"; do
      kill -0 "$pid" 2>/dev/null && alive+=("$pid")
    done
    [ ${#alive[@]} -eq 0 ] && return 0
    if [ $tries -ge 20 ]; then
      kill -KILL "${alive[@]}" 2>/dev/null
      return 0
    fi
    sleep 0.1
    tries=$((tries + 1))
  done
}

# Record a single utterance into the given file, blocking until trailing
# silence is detected (or DURATION expires). All use of the audio-capture
# tool for utterances lives here, so another recorder would replace only the
# body of this function.
#
# Contract (pinned by tests/recording.bats):
#   - blocks until the utterance is complete and the file is fully written
#   - honours MIN_VOLUME (percent or dBFS), SILENCE_LENGTH, DURATION
#   - writes the encoded audio to the path given as $1
#   - returns the capture tool's own exit status, so the caller can tell
#     "rec failed to start" (no mic, permission denied) apart from
#     "rec ran fine but nobody spoke" (which exits 0)
#   - returns the encoder's status when capture succeeded but encoding failed
function record_utterance() {
  local out_file=$1
  local -a rec_args=(-q -V0 -e signed -L -c 1 -b 16 -r 44100 -t raw -)
  if [ "$DURATION" -gt 0 ]; then
    rec_args+=(trim 0 "$DURATION")
  fi
  rec_args+=(silence 1 0.1 "$MIN_VOLUME" 1 "$SILENCE_LENGTH" "$MIN_VOLUME")
  rec "${rec_args[@]}" | sox -t raw -r 44100 -b 16 -e signed -c 1 - "$out_file"
  # rec's status comes first: it tells "no device" apart from silence. An
  # encoder failure (sox) must not pass for a recorded utterance either.
  local -a statuses=("${PIPESTATUS[@]}")
  [ "${statuses[0]}" -ne 0 ] && return "${statuses[0]}"
  return "${statuses[1]}"
}

# Run the local whisper.cpp binary against an audio file and echo the
# transcription text. Used by convert_audio_to_text when BACKEND=local.
function run_local_whisper_cpp() {
  local input_file=$1
  local out_prefix
  out_prefix=$(mktemp "${TMPDIR:-/tmp}/whisper-stream-local.XXXXXX") || {
    echo "Error: failed to create temporary output prefix" >&2
    return 1
  }
  # mktemp creates an empty file; we only want the unique name as a prefix.
  rm -f "$out_prefix"

  local -a wcli_args=(
    -m "$MODEL_PATH"
    -f "$input_file"
    -oj
    -nt
    -np
    -of "$out_prefix"
  )
  [ -n "$LANGUAGE" ] && wcli_args+=(-l "$LANGUAGE")
  [ -n "$PROMPT" ]   && wcli_args+=(--prompt "$PROMPT")
  [ -n "$TRANSLATE" ] && wcli_args+=(-tr)
  if [ "$VAD" = true ]; then
    wcli_args+=(--vad --vad-model "$VAD_MODEL_PATH")
  fi

  # Suppress the GGML backend init logs (stderr) and any non-JSON stdout.
  "$WHISPER_CLI" "${wcli_args[@]}" >/dev/null 2>&1
  local rc=$?
  local json_file="${out_prefix}.json"
  if [ $rc -ne 0 ] || [ ! -f "$json_file" ]; then
    rm -f "$json_file"
    return 1
  fi

  jq -r '[.transcription[].text] | join("") | sub("^ +"; "")' "$json_file"
  local jq_rc=$?
  rm -f "$json_file"
  return $jq_rc
}

# Classify one API attempt: "ok" (a response to check), "retry" (transient:
# network failure, timeout, rate limit, overload, 5xx), or "fail". Billing,
# spend, and quota 429s fail at once: waiting does not restore access.
function api_attempt_verdict() {
  local curl_status=$1 http_code=$2 body=$3
  if [ "$curl_status" -ne 0 ]; then
    case "$curl_status" in
      # proxy/DNS/connect failure, partial transfer, timeout, TLS handshake,
      # empty reply, send/receive error
      5|6|7|18|28|35|52|55|56) echo retry ;;
      *) echo fail ;;
    esac
    return 0
  fi
  case "$http_code" in
    ""|2??) echo ok ;;
    408|500|502|503|504) echo retry ;;
    429)
      if echo "$body" | jq -e '
          .error | type == "object" and (
            .type == "insufficient_quota" or
            (.code | IN("insufficient_quota", "credit_balance_exhausted",
                        "organization_spend_limit_exceeded", "project_spend_limit_exceeded",
                        "organization_usage_limit_exceeded")))' >/dev/null 2>&1; then
        echo fail
      else
        echo retry
      fi
      ;;
    *) echo fail ;;
  esac
}

# Seconds the server asked to wait before a retry, read from the last header
# block in the file curl -D wrote: Retry-After as seconds or as an HTTP-date
# (0 when already past), or retry-after-ms rounded up; the larger when both
# are sent. Prints nothing when absent or unreadable.
function retry_after_seconds() {
  local parsed ms ra secs="" epoch
  parsed=$(LC_ALL=C awk '
    { sub(/\r$/, "") }
    tolower($1) ~ /^http\// { ra = ""; ms = "" }
    tolower($1) == "retry-after:" { ra = $0; sub(/^[^:]*:[ \t]*/, "", ra) }
    tolower($1) == "retry-after-ms:" && $2 ~ /^[0-9]+(\.[0-9]+)?$/ {
      s = $2 / 1000
      ms = (s == int(s)) ? s : int(s) + 1
    }
    END { print ms; print ra }' "$1" 2>/dev/null) || return 0
  ms=${parsed%%$'\n'*}
  ra=${parsed#*$'\n'}

  if [[ "$ra" =~ ^[0-9]+$ ]]; then
    secs=$((10#$ra))
  elif [ -n "$ra" ]; then
    # HTTP-date (RFC 9110): GNU date, then BSD date.
    epoch=$(LC_ALL=C date -u -d "$ra" +%s 2>/dev/null \
      || LC_ALL=C date -u -j -f '%a, %d %b %Y %H:%M:%S GMT' "$ra" +%s 2>/dev/null) || epoch=""
    if [[ "$epoch" =~ ^[0-9]+$ ]]; then
      secs=$((epoch - $(date +%s)))
      [ "$secs" -lt 0 ] && secs=0
    fi
  fi
  if [ -n "$ms" ] && { [ -z "$secs" ] || [ "$ms" -gt "$secs" ]; }; then
    secs=$ms
  fi
  if [ -n "$secs" ]; then
    echo "$secs"
  fi
}

# Backoff in seconds before attempt $1 + 1: API_RETRY_BASE_DELAY doubled per
# attempt, capped at 30, plus up to 1 s of jitter.
function api_backoff_delay() {
  LC_ALL=C awk -v base="$API_RETRY_BASE_DELAY" -v n="$1" -v r="$RANDOM" 'BEGIN {
    d = base * 2 ^ (n - 1)
    if (d > 30) d = 30
    if (base > 0) d += r / 32767
    printf "%.3f", d
  }'
}

# Short reason for a curl exit status ($2 is the time limit in seconds).
function curl_failure_reason() {
  case "$1" in
    6) echo "could not resolve host" ;;
    7) echo "could not connect" ;;
    28) echo "no response within ${2}s" ;;
    35) echo "TLS handshake failed" ;;
    52) echo "empty reply from server" ;;
    18|55|56) echo "connection lost" ;;
    *) echo "curl exit status $1" ;;
  esac
}

# Convert the audio to text using the OpenAI speech-to-text API or local whisper.cpp.
#
# Return value: 0 when the utterance was transcribed OR deliberately skipped
# (too short to be speech); non-zero when it FAILED (API/HTTP/backend error).
# The real-time loop ignores this — one bad utterance must not end a session —
# but file mode (-f) turns it into the process exit status so that callers
# like `whisper-stream -f x.mp3 > out.txt || alert` can detect the failure.
#
# $2 (optional) is the utterance's capture sequence number, emitted as `seq`
# in JSONL. API calls run concurrently, so completion order (and `ts`) can
# differ from speaking order; `seq` cannot.
function convert_audio_to_text() {
  local output_file=$1
  local seq=${2:-}

  # Measured input duration in seconds, reported as JSONL `duration`. Best
  # effort in both modes: file mode does not require SoX, and soxi cannot
  # read every format the API accepts, so anything non-numeric becomes null.
  local duration=""
  duration=$(soxi -D "$output_file" 2>/dev/null) || true
  # LC_ALL=C: a decimal-comma locale would make awk print "4,180", which is
  # not a JSON number.
  if [[ "$duration" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    duration=$(LC_ALL=C awk -v d="$duration" 'BEGIN { printf "%.3f", d }')
  else
    duration=""
  fi

  # Skip utterances that are too short. SoX silence detection can be fooled
  # by brief noise, producing tiny clips that waste API budget and add empty
  # rows to the accumulated transcript. awk is used because bash arithmetic
  # cannot compare floats.
  #
  # Only applies in real-time mode. In file mode (-f) the user explicitly
  # picked the input, so always honour their choice — silently dropping a
  # short clip there would be a confusing regression.
  #
  # An unknown duration (soxi failed) is treated as "do not skip".
  if [ -z "$AUDIO_FILE" ]; then
    if [ -n "$duration" ] && LC_ALL=C awk -v d="$duration" -v m="$MIN_AUDIO_DURATION" 'BEGIN { exit !(d+0 > 0 && d+0 < m+0) }'; then
      rm -f "$output_file"
      return 0
    fi
  fi

  # Local backend path: delegate to whisper.cpp and short-circuit the API
  # flow. JSONL, --pipe-to, temp_transcriptions.txt accumulation, and
  # output-file cleanup still run exactly as with the API backend.
  if [ "$BACKEND" = "local" ]; then
    local transcription display_text rc
    display_text=$(run_local_whisper_cpp "$output_file")
    rc=$?
    if [ $rc -ne 0 ] || [ -z "$display_text" ]; then
      # Skip this utterance entirely. Log the failure to stderr so the
      # user can see something went wrong, but do not pollute stdout or
      # the clipboard/file output with an error sentinel. The recording
      # loop continues with the next utterance.
      echo "Warning: local backend failed for $output_file (rc=$rc); skipping utterance" >&2
      if [ -z "$AUDIO_FILE" ]; then
        rm -f "$output_file"
      fi
      return 1
    fi
    transcription="$display_text"

    # A record that fails to serialize is a failure, not a silent success.
    local emit_rc=0
    if [ "$JSONL_MODE" = true ]; then
      jq -nc \
        --argjson version "$JSONL_SCHEMA_VERSION" \
        --argjson seq "${seq:-null}" \
        --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --arg model "local:$(basename "$MODEL_PATH")" \
        --argjson duration "${duration:-null}" \
        --arg text "$display_text" \
        '{version:$version, seq:$seq, ts:$ts, model:$model, duration:$duration, languages:null, text:$text}' \
        || emit_rc=1
    else
      echo "$display_text"
    fi

    if [ -n "$PIPE_TO_CMD" ]; then
      local result
      result=$(echo "$display_text" | bash -c "$PIPE_TO_CMD")
      echo "$result"
    fi

    if [ -z "$AUDIO_FILE" ]; then
      rm -f "$output_file"
    fi
    echo "$transcription" >> "${WORK_DIR:-.}/temp_transcriptions.txt"
    [ $emit_rc -ne 0 ] && echo "Warning: failed to write the JSONL record for $output_file" >&2
    return $emit_rc
  fi

  # Endpoint: default to OpenAI's transcriptions URL, or use the user-supplied
  # --api-url for self-hosted OpenAI-compatible servers (e.g. whisper-server).
  local base_url="${API_URL:-https://api.openai.com/v1/audio/transcriptions}"

  # Determine response format based on options. Diarization needs the special
  # diarized_json format; everything else uses plain json.
  local response_format="json"
  if [ "$DIARIZE" = true ] && [[ "$MODEL" == gpt-4o-transcribe-diarize* ]]; then
    response_format="diarized_json"
  fi

  # Per-request temp files (credentials, response headers, speaker
  # references). In a session they go into the private WORK_DIR, so that
  # removing it also removes them when a worker is killed mid-request.
  # mktemp uses a portable template (mktemp -t has incompatible semantics on
  # GNU vs BSD).
  local temp_dir="${WORK_DIR:-${TMPDIR:-/tmp}}"
  local -a temp_files=()

  # Write the API credentials to a private temp config file when a token is
  # available. This keeps the bearer token out of argv (visible via ps).
  local auth_file=""
  if [ -n "$TOKEN" ]; then
    auth_file=$(mktemp "$temp_dir/whisper-stream.XXXXXX") || {
      echo "Error: failed to create temporary auth file" >&2
      return 1
    }
    temp_files+=("$auth_file")
    chmod 600 "$auth_file"
    printf 'header = "Authorization: Bearer %s"\n' "$TOKEN" > "$auth_file"
  fi

  # Response headers, for the server's Retry-After.
  local header_file
  header_file=$(mktemp "$temp_dir/whisper-stream-headers.XXXXXX") || {
    echo "Error: failed to create temporary header file" >&2
    rm -f "${temp_files[@]}"
    return 1
  }
  temp_files+=("$header_file")

  # Each attempt has its own time limit; file mode allows for large uploads.
  local timeout=${API_TIMEOUT:-120}
  [ -n "$AUDIO_FILE" ] && timeout=${API_TIMEOUT:-600}

  # Build curl arguments as an array so that user-controlled fields
  # (PROMPT, LANGUAGE, file paths) are never re-interpreted by the shell.
  # -w appends the HTTP status code on its own line so non-2xx responses can
  # be rejected even when the body is not an OpenAI-style error JSON.
  #
  # Text fields use --form-string: with --form, curl itself would read a
  # value starting with `<` from a file, upload one starting with `@`, and
  # parse `;type=`. --form is kept only where that is intended (the audio
  # upload and the speaker reference files below).
  local curl_args=(
    -s --request POST
    --connect-timeout 15
    --max-time "$timeout"
    -D "$header_file"
    -w $'\n%{http_code}'
    --url "$base_url"
    --form "file=@$output_file"
    --form-string "model=$MODEL"
    --form-string "response_format=$response_format"
  )
  [ -n "$auth_file" ] && curl_args=(--config "$auth_file" "${curl_args[@]}")

  # Prompt is supported everywhere except on gpt-4o-transcribe-diarize*
  if [ -n "$PROMPT" ] && [[ "$MODEL" != gpt-4o-transcribe-diarize* ]]; then
    curl_args+=(--form-string "prompt=$PROMPT")
  fi

  # gpt-transcribe takes `languages[]` (and rejects it together with the
  # singular field); older models take one `language`. validate_config has
  # already rejected several codes for models that accept only one.
  parse_language_list || true
  local lang kw
  if [ ${#LANGUAGES[@]} -gt 0 ]; then
    if model_takes_context_fields || [ ${#LANGUAGES[@]} -gt 1 ]; then
      for lang in "${LANGUAGES[@]}"; do
        curl_args+=(--form-string "languages[]=$lang")
      done
    else
      curl_args+=(--form-string "language=${LANGUAGES[0]}")
    fi
  fi
  if [ ${#KEYWORDS[@]} -gt 0 ]; then
    for kw in "${KEYWORDS[@]}"; do
      curl_args+=(--form-string "keywords[]=$kw")
    done
  fi

  # Diarization-specific parameters
  if [ "$DIARIZE" = true ] && [[ "$MODEL" == gpt-4o-transcribe-diarize* ]]; then
    curl_args+=(--form-string "chunking_strategy=$CHUNKING_STRATEGY")

    if [ ${#KNOWN_SPEAKERS[@]} -gt 0 ]; then
      local speakers_json="$SPEAKER_DIR/speakers.json"
      local speaker_key
      for speaker_key in "${KNOWN_SPEAKERS[@]}"; do
        local speaker_name speaker_file encoded_ref ref_file
        speaker_name=$(jq -r --arg k "$speaker_key" '.[$k].name' "$speakers_json")
        speaker_file="$SPEAKER_DIR/$(jq -r --arg k "$speaker_key" '.[$k].file' "$speakers_json")"
        if [ -f "$speaker_file" ]; then
          # Write the base64 data URL to a private temp file and hand it to
          # curl via `--form 'field=<file'` (file-read syntax, NOT the @file
          # attachment syntax). Inlining the data URL in argv would exceed
          # ARG_MAX (1 MB on macOS) for typical 2-10 s samples — this made
          # known-speaker diarization fail with E2BIG.
          encoded_ref=$(encode_speaker_reference "$speaker_file")
          ref_file=$(mktemp "$temp_dir/whisper-stream-speaker.XXXXXX") || {
            echo "Error: failed to create temporary speaker reference file" >&2
            rm -f "${temp_files[@]}"
            return 1
          }
          temp_files+=("$ref_file")
          chmod 600 "$ref_file"
          printf '%s' "$encoded_ref" > "$ref_file"
          curl_args+=(--form-string "known_speaker_names[]=$speaker_name")
          curl_args+=(--form "known_speaker_references[]=<$ref_file")
        fi
      done
    fi
  fi

  # Safety net: remove the temp files even if the function is interrupted by
  # a signal (SIGINT/SIGTERM) before the explicit cleanup below.
  trap 'rm -f "${temp_files[@]}"' EXIT

  # The whole request is retried on transient failures; the outcome of the
  # last attempt is what gets reported below.
  local attempt=1 response="" curl_status=0 http_code="" verdict retry_after delay
  while true; do
    : > "$header_file"
    response=$(curl "${curl_args[@]}")
    curl_status=$?

    # Split off the status line that -w appends. Only a bare 3-digit final
    # line counts: tolerating its absence must not eat the last line of a
    # pretty-printed JSON body from a server (or test double) that did not
    # produce one.
    http_code=""
    if [[ "$response" == *$'\n'* ]]; then
      local last_line="${response##*$'\n'}"
      if [[ "$last_line" =~ ^[0-9]{3}$ ]]; then
        http_code="$last_line"
        response="${response%$'\n'*}"
      fi
    fi

    verdict=$(api_attempt_verdict "$curl_status" "$http_code" "$response")
    if [ "$verdict" != "retry" ] || [ "$attempt" -ge "$API_MAX_ATTEMPTS" ]; then
      break
    fi
    retry_after=$(retry_after_seconds "$header_file")
    if [ -n "$retry_after" ] && [ "$retry_after" -gt "$API_RETRY_MAX_WAIT" ]; then
      echo "Warning: the server asked to wait ${retry_after}s before retrying (more than ${API_RETRY_MAX_WAIT}s); not retrying" >&2
      break
    fi
    delay=$(api_backoff_delay "$attempt")
    if [ -n "$retry_after" ] && LC_ALL=C awk -v r="$retry_after" -v d="$delay" 'BEGIN { exit !(r + 0 > d + 0) }'; then
      delay=$retry_after
    fi
    # Route progress/retry indicators to stderr, and only when we're
    # attached to a real terminal. Pipe-native mode (STDOUT_MODE) skips
    # them entirely so that callers capturing 2>&1 get a clean stream.
    if [ "$STDOUT_MODE" = false ] && [ -t 2 ]; then
      printf "\e[1;31m.\e[0m" >&2
    fi
    sleep "$delay"
    attempt=$((attempt + 1))
  done

  rm -f "${temp_files[@]}"
  trap - EXIT
  if [ "$STDOUT_MODE" = false ] && [ -t 2 ]; then
    printf "\r\e[K" >&2
  fi

  # A transfer that failed (even after a 200 status and part of the body)
  # is not a transcript.
  if [ "$curl_status" -ne 0 ]; then
    echo "Warning: API request failed ($(curl_failure_reason "$curl_status" "$timeout")); skipping utterance" >&2
    if [ -z "$AUDIO_FILE" ]; then
      rm -f "$output_file"
    fi
    return 1
  fi

  # Reject non-2xx responses even when the body is not an OpenAI-style error
  # JSON (self-hosted servers and proxies often return FastAPI-style
  # {"detail": ...} or plain HTML, which would otherwise leak into the
  # transcript as garbage text).
  if [[ "$http_code" =~ ^[0-9]{3}$ ]] && [[ ! "$http_code" =~ ^2 ]]; then
    # This check runs before the .error extraction below, so pull the API's
    # own message in here too — "HTTP 429" alone cannot tell a rate limit
    # from an exhausted quota.
    local http_detail
    http_detail=$(echo "$response" | jq -r '.error.message // empty' 2>/dev/null || true)
    if [ -n "$http_detail" ]; then
      echo "Warning: API request failed (HTTP $http_code), skipping utterance: $http_detail" >&2
    else
      echo "Warning: API request failed (HTTP $http_code); skipping utterance" >&2
    fi
    # OpenAI answers a bad language code, a bad keyword, or an over-long
    # prompt with a bare "Invalid request." that names none of them.
    if [ "$http_code" = "400" ] && [ "$http_detail" = "Invalid request." ] \
       && { [ ${#LANGUAGES[@]} -gt 0 ] || [ ${#KEYWORDS[@]} -gt 0 ] || [ -n "$PROMPT" ]; }; then
      echo "Hint: this may be caused by a --language code (use ISO 639-1 such as 'en', or 'zh-cn')," >&2
      echo "      a --keyword term, or a --prompt that is too long." >&2
    fi
    if [ -z "$AUDIO_FILE" ]; then
      rm -f "$output_file"
    fi
    return 1
  fi

  if [ -z "$response" ]; then
    echo "Warning: empty API response; skipping utterance" >&2
    if [ -z "$AUDIO_FILE" ]; then
      rm -f "$output_file"
    fi
    return 1
  fi

  # If the API responded with a structured error, log to stderr and skip the
  # utterance entirely instead of treating the error message as a transcription.
  # `|| true` keeps jq's exit status from poisoning $? on non-JSON bodies.
  local api_error
  api_error=$(echo "$response" | jq -r '.error.message // empty' 2>/dev/null || true)
  if [ -n "$api_error" ]; then
    echo "Warning: API error: $api_error" >&2
    if [ -z "$AUDIO_FILE" ]; then
      rm -f "$output_file"
    fi
    return 1
  fi

  # A 2xx body must be a transcription object: an HTML page from a proxy, a
  # truncated body, or JSON without the text would otherwise be printed (or
  # accumulated) as if it were what was said. An empty text is valid.
  local response_shape='type == "object" and (.text | type) == "string"'
  if [ "$response_format" = "diarized_json" ]; then
    response_shape='type == "object" and (
      if (.segments | type) == "array" then
        all(.segments[]; (.start | type) == "number" and (.speaker | type) == "string" and (.text | type) == "string")
      else
        (.text | type) == "string"
      end)'
  fi
  # -s: the body must be exactly one JSON value (jq -e alone judges only the
  # last of several).
  if ! echo "$response" | jq -s -e "length == 1 and (.[0] | $response_shape)" >/dev/null 2>&1; then
    echo "Warning: unexpected API response (no transcript text); skipping utterance" >&2
    if [ -z "$AUDIO_FILE" ]; then
      rm -f "$output_file"
    fi
    return 1
  fi

  # Process response based on format
  local transcription=""
  local display_text=""

  if [ "$response_format" = "diarized_json" ]; then
    # Diarized response - format for display
    transcription="$response"

    # Format segments with speaker labels, or fall back to the plain text.
    display_text=$(echo "$response" | jq -r '
      if (.segments | type) == "array" then
        .segments[] |
        "[" + (.start | floor | tostring) + "s] " + .speaker + ": " + .text
      else
        .text
      end
    ' 2>/dev/null || true)

  else
    # Plain JSON response
    transcription=$(echo "$response" | jq -r '.text')
    display_text="$transcription"
  fi

  # Primary transcription output.
  # In JSONL mode, emit one JSON object per utterance using jq so that the
  # text is properly escaped. `languages` is what the model detected
  # (gpt-transcribe; [] means it could not tell), or null when the response
  # has no such field — never the --language hints.
  local emit_rc=0
  if [ "$JSONL_MODE" = true ]; then
    local detected_languages
    detected_languages=$(echo "$response" | jq -c 'if (.languages | type) == "array" then .languages else null end' 2>/dev/null || true)
    jq -nc \
      --argjson version "$JSONL_SCHEMA_VERSION" \
      --argjson seq "${seq:-null}" \
      --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      --arg model "$MODEL" \
      --argjson duration "${duration:-null}" \
      --argjson languages "${detected_languages:-null}" \
      --arg text "$display_text" \
      '{version:$version, seq:$seq, ts:$ts, model:$model, duration:$duration, languages:$languages, text:$text}' \
      || emit_rc=1
  else
    echo "$display_text"
  fi

  if [ -n "$PIPE_TO_CMD" ]; then
    # PIPE_TO_CMD is intentionally interpreted as a shell command, because the
    # -p2 option exists specifically so users can supply shell pipelines like
    # "wc -w". Unlike PROMPT/LANGUAGE (opaque data sent to the API), this value
    # is expected to be executed by the user's shell.
    result=$(echo "$display_text" | bash -c "$PIPE_TO_CMD")
    echo "$result"
  fi

  # Remove the output audio file unless the `-f` option is specified
  if [ -z "$AUDIO_FILE" ]; then
    rm -f "$output_file"
  fi

  # Accumulate the transcribed text in a temporary file
  # this is necessary for the data to be available when the script terminates
  echo "$transcription" >> "${WORK_DIR:-.}/temp_transcriptions.txt"

  if [ $emit_rc -ne 0 ]; then
    echo "Warning: failed to write the JSONL record for $output_file" >&2
  fi
  return $emit_rc
}

# Preserve the accumulated transcription in a file when no clipboard tool is
# available (e.g. xclip missing on Linux). Without this, the text would be
# lost entirely in non-stdout mode without an output directory.
function save_transcription_fallback() {
  local text=$1
  local fallback="${OUTPUT_DIR:-.}/transcription_$(date +%Y-%m-%d_%H-%M-%S).txt"
  printf '%s\n' "$text" > "$fallback"
  echo "Warning: clipboard tool not available; transcription saved to $fallback" >&2
}

# Handle the script termination: clean up and save transcriptions
function handle_exit() {
  # Optional $1 is the status to exit with. Defaults to 0 so that using
  # this function directly as a signal handler (trap) still exits clean.
  local exit_status=${1:-0}

  # A second signal while the queue drains interrupts the `wait` below
  # (bash 3.2), or re-enters this handler first (bash 4+). Either way the
  # first invocation handles it, so a re-entry does nothing.
  if [ "${EXIT_IN_PROGRESS:-false}" = true ]; then
    return
  fi
  EXIT_IN_PROGRESS=true

  # Real-time mode: let the dispatcher finish the utterances already
  # recorded, including the one being recorded when the signal arrived (the
  # trap runs after the recording pipeline has exited, so that file is
  # complete). The stop request is created only after this last `mv`.
  # Another Ctrl-C stops waiting and discards the rest.
  if [ -n "${DISPATCHER_PID:-}" ]; then
    if [ -n "${OUTPUT_FILE:-}" ] && [ -s "$OUTPUT_FILE" ] \
       && ! mv "$OUTPUT_FILE" "$QUEUE_DIR/"; then
      echo "Error: could not queue the utterance being recorded; it was not transcribed." >&2
      exit_status=1
    fi
    : > "$WORK_DIR/stop"
    local pending discarded=false dispatcher_status=0
    pending=$(( $(count_utterances "$QUEUE_DIR") + $(count_utterances "$ACTIVE_DIR") ))
    if [ "$pending" -gt 0 ] && kill -0 "$DISPATCHER_PID" 2>/dev/null; then
      echo "Finishing $pending recorded utterance(s); press Ctrl-C again to discard them." >&2
    fi
    wait "$DISPATCHER_PID" 2>/dev/null
    dispatcher_status=$?
    if [ "$dispatcher_status" -ne 0 ] && kill -0 "$DISPATCHER_PID" 2>/dev/null; then
      # The wait was interrupted by another signal: discard the rest.
      pending=$(( $(count_utterances "$QUEUE_DIR") + $(count_utterances "$ACTIVE_DIR") ))
      kill_process_tree "$DISPATCHER_PID"
      wait "$DISPATCHER_PID" 2>/dev/null
      discarded=true
      if [ "$pending" -gt 0 ]; then
        echo "Discarded $pending utterance(s)." >&2
      fi
    elif [ "$dispatcher_status" -ne 0 ] && [ "$dispatcher_status" -ne 127 ]; then
      # 127: no status to collect (not a child, e.g. in tests).
      echo "Error: the transcription worker failed (exit status $dispatcher_status)." >&2
      exit_status=1
    fi
    # Anything still queued now was not discarded on request: the
    # dispatcher died. That fails the session.
    if [ "$discarded" = false ]; then
      pending=$(( $(count_utterances "$QUEUE_DIR") + $(count_utterances "$ACTIVE_DIR") ))
      if [ "$pending" -gt 0 ]; then
        echo "Error: $pending recorded utterance(s) were not transcribed: the transcription worker stopped." >&2
        exit_status=1
      fi
    fi
  fi

  # Wait for any other background jobs, then kill what is left.
  wait
  pkill -P $$

  # Read the accumulated transcription (if any), then drop the per-session
  # work directory — it holds the audio chunks and temp_transcriptions.txt.
  local transcript_file="${WORK_DIR:-.}/temp_transcriptions.txt"
  local accumulated_text=""
  local had_transcript=false
  if [ -f "$transcript_file" ]; then
    accumulated_text=$(cat "$transcript_file")
    had_transcript=true
  fi
  if [ -n "${WORK_DIR:-}" ] && [ -d "$WORK_DIR" ]; then
    rm -rf "$WORK_DIR"
  fi

  if [ "$had_transcript" = true ]; then
    # Clear the current line (after the spinner). Only do this when attached
    # to a real terminal AND not in pipe-native mode — otherwise the escape
    # sequence pollutes a piped stdout stream and breaks jq/sed/etc.
    if [ "$STDOUT_MODE" = false ] && [ -t 1 ]; then
      printf "\r\e[K\n"
    fi
  else
    if [ "$STDOUT_MODE" = false ] && [ -t 1 ]; then
      printf "\r\e[K"
    fi
    exit "$exit_status"
  fi

  # In pipe-native mode, skip all side effects: no file saving, no clipboard,
  # no "copied" confirmation. The transcriptions already went to stdout.
  if [ "$STDOUT_MODE" = true ]; then
    exit "$exit_status"
  fi

  # If output directory is specified, create a file with the accumulated text in the specified directory
  if [ -n "$OUTPUT_DIR" ]; then
    timestamp=$(date +"%Y-%m-%d_%H-%M-%S")
    if [ "$DIARIZE" = true ]; then
      # JSON output for diarization (raw API response per utterance)
      echo "$accumulated_text" > "$OUTPUT_DIR/transcription_$timestamp.json"
    else
      # Plain text output
      echo "$accumulated_text" > "$OUTPUT_DIR/transcription_$timestamp.txt"
    fi
  fi

  # Copy the accumulated text to the clipboard. When the clipboard tool is
  # missing, fall back to a file so the transcription is never lost.
  case "$(uname -s)" in
    Darwin)
      if [ -n "$accumulated_text" ]; then
        if command -v pbcopy >/dev/null 2>&1; then
          printf '%s\n' "$accumulated_text" | pbcopy
          echo $'\e[0;36m'Transcription copied to clipboard.$'\e[0m'
        elif [ -z "$OUTPUT_DIR" ]; then
          save_transcription_fallback "$accumulated_text"
        fi
      fi
      ;;
    Linux)
      if [ -n "$accumulated_text" ]; then
        if command -v xclip >/dev/null 2>&1; then
          printf '%s\n' "$accumulated_text" | xclip -selection clipboard
          echo $'\e[0;36m'Transcription copied to clipboard.$'\e[0m'
        elif [ -z "$OUTPUT_DIR" ]; then
          save_transcription_fallback "$accumulated_text"
        fi
      fi
      ;;
    CYGWIN*|MINGW32*|MSYS*|MINGW*)
      # This is a rough guess that you're on Windows Subsystem for Linux
      # if $accumulated_text is not empty
      if [ -n "$accumulated_text" ]; then
        echo "$accumulated_text" | clip.exe >&1
        echo $'\e[0;36m'Transcription copied to clipboard.$'\e[0m'
      fi
      ;;
    *)
      echo "Unknown OS, cannot copy to clipboard"
      ;;
  esac

  exit "$exit_status"
}

# Library mode: skip main execution (file mode + recording loop).
# Function definitions above are still sourced normally.
if [[ "${WHISPER_STREAM_LIB:-0}" != "1" ]]; then

# Handle termination for BOTH file mode and the real-time loop: without
# this, a signal during -f transcription leaves the session work dir behind.
# EXIT is deliberately not used: convert_audio_to_text clears it with
# `trap - EXIT` after removing its own temp files, which would silently
# disable a global handler. Catch the terminating signals instead.
trap handle_exit SIGINT SIGTSTP SIGTERM SIGHUP

# If an audio file is provided, convert it to text and then exit
if [ -n "$AUDIO_FILE" ]; then

  # Handle speaker registration if requested
  if [ "$REGISTER_SPEAKERS" = true ] || ([ "$DIARIZE" = true ] && [ "$MODEL" = "gpt-4o-transcribe-diarize" ]); then
    if [ "$REGISTER_SPEAKERS" = true ]; then
      # Explicit speaker registration requested
      register_speakers_interactive
    else
      # Diarization without explicit registration - offer to register
      if [ "$QUIET_MODE" = false ]; then
        echo ""
        echo "Diarization mode enabled."
        echo "Register known speakers? (y/N): "
        read -r register_choice
        if [[ "$register_choice" =~ ^[Yy]$ ]]; then
          register_speakers_interactive
        fi
      fi
    fi
  fi

  # print banner and settings unless quiet mode is enabled
  # this is necessary for the data to be available when the script terminates
  if [ "$QUIET_MODE" = false ]; then
    echo ""
    echo $'\e[1;34m'Whisper Stream Transcriber$'\e[0m' ${VERSION}
    echo $'\e[1;33m'-----------------------------------------------$'\e[0m'
    echo "Current settings:"
    echo "  Backend: $BACKEND"
    if [ "$BACKEND" = "local" ]; then
      echo "  Model: $(basename "$MODEL_PATH")"
    else
      echo "  Model: $MODEL"
    fi
    echo "  Input language: ${LANGUAGE:-Not specified}"
    if [ ${#KEYWORDS[@]} -gt 0 ]; then
      echo "  Keywords: ${#KEYWORDS[@]}"
    fi

    if [ -n "$TRANSLATE" ]; then
      echo "  Translate to English: $TRANSLATE"
    fi

    if [ "$DIARIZE" = true ]; then
      echo "  Diarization: enabled"
      if [ ${#KNOWN_SPEAKERS[@]} -gt 0 ]; then
        echo "  Known speakers: ${#KNOWN_SPEAKERS[@]}"
      fi
    fi

    if [ -n "$OUTPUT_DIR" ]; then
      echo "  Output Dir: $OUTPUT_DIR"
    fi

    echo "  Input file: $AUDIO_FILE"
    echo $'\e[1;33m'-----------------------------------------------$'\e[0m'
    echo $'\e[0;36m'Please wait ...$'\e[0m'
    echo ""
  fi

  convert_audio_to_text "$AUDIO_FILE" 1
  handle_exit $?
fi

# Display the current configuration/settings of the script
display_settings


# Main loop: record utterances back to back and queue them for the
# dispatcher, so recording never waits for a transcription. The API backend
# runs up to MAX_JOBS requests at once; the local backend runs one
# whisper-cli at a time (several contend for the GPU/CPU and can
# destabilize Metal on Apple Silicon), which also keeps its output in order.
QUEUE_DIR="$WORK_DIR/queue"
ACTIVE_DIR="$WORK_DIR/active"
mkdir -p "$QUEUE_DIR" "$ACTIVE_DIR"
if [ "$BACKEND" = "local" ]; then
  dispatch_utterances 1 &
else
  dispatch_utterances "$MAX_JOBS" &
fi
DISPATCHER_PID=$!

rec_failures=0  # consecutive rec-launch failures (busy-loop guard)
utterance_seq=0 # capture sequence number (JSONL `seq`)
while true; do
  if ! wait_for_queue_space; then
    echo "Error: the transcription worker stopped unexpectedly." >&2
    handle_exit 1
  fi

  # The sequence number keeps chunk names unique and in capture order; the
  # work dir is per session.
  utterance_seq=$((utterance_seq + 1))
  OUTPUT_FILE=$(printf '%s/output_%06d.mp3' "$WORK_DIR" "$utterance_seq")

  # Record one utterance (blocks until silence or the duration limit).
  # A non-zero status means the capture tool failed (no device, permission
  # denied, encoder error, ...) — NOT silence: rec exits 0 normally, so
  # `-d 60` with nobody speaking lands in the "-s check" below, never here.
  # Without this guard a failing rec would spin the loop at full speed
  # forever.
  if record_utterance "$OUTPUT_FILE"; then
    rec_failures=0
  else
    rm -f "$OUTPUT_FILE"
    rec_failures=$((rec_failures + 1))
    echo "Warning: audio capture failed ($rec_failures/3)" >&2
    if [ "$rec_failures" -ge 3 ]; then
      echo "Error: audio capture failed 3 times in a row; giving up." >&2
      handle_exit 1
    fi
    sleep 2
    continue
  fi

  # Hand a non-empty recording to the dispatcher. The rename is atomic, so
  # it never picks up a file that is still being written.
  if [ -s "$OUTPUT_FILE" ]; then
    if ! mv "$OUTPUT_FILE" "$QUEUE_DIR/"; then
      echo "Warning: could not queue $(basename "$OUTPUT_FILE"); skipping it" >&2
      rm -f "$OUTPUT_FILE"
    fi
  else
    rm -f "$OUTPUT_FILE"
    echo "No audio recorded." >&2
  fi

  if [ "$ONESHOT" = true ]; then
    break
  fi
done

# Handle final cleanup and exit
handle_exit

fi  # end library-mode guard: end of main execution block
