# Display a rotating spinner animation
function spinner() {
  local pid=$1
  local delay=0.1
  local spinstr='|/-\\'
  while kill -0 $pid 2>/dev/null; do
    local temp=${spinstr#?}
    printf "\r\e[1;31m%c\e[0m" "$spinstr"
    local spinstr=$temp${spinstr%"$temp"}
    sleep $delay
  done
  printf "\r\e[K"
}

# Run the local whisper.cpp binary against an audio file and echo the
# transcription text. Used by convert_audio_to_text when BACKEND=local.
function run_local_whisper_cpp() {
  local input_file=$1
  local out_prefix
  out_prefix=$(mktemp "${TMPDIR:-/tmp}/whisper-stream-local.XXXXXX") || {
    echo "Error: failed to create temporary output prefix" >&2
    return 1
  }
  # mktemp creates an empty file; we only want the unique name as a prefix.
  rm -f "$out_prefix"

  local -a wcli_args=(
    -m "$MODEL_PATH"
    -f "$input_file"
    -oj
    -nt
    -np
    -of "$out_prefix"
  )
  [ -n "$LANGUAGE" ] && wcli_args+=(-l "$LANGUAGE")
  [ -n "$PROMPT" ]   && wcli_args+=(--prompt "$PROMPT")
  [ -n "$TRANSLATE" ] && wcli_args+=(-tr)

  # Suppress the GGML backend init logs (stderr) and any non-JSON stdout.
  whisper-cli "${wcli_args[@]}" >/dev/null 2>&1
  local rc=$?
  local json_file="${out_prefix}.json"
  if [ $rc -ne 0 ] || [ ! -f "$json_file" ]; then
    rm -f "$json_file"
    return 1
  fi

  jq -r '[.transcription[].text] | join("") | sub("^ +"; "")' "$json_file"
  local jq_rc=$?
  rm -f "$json_file"
  return $jq_rc
}

# Convert the audio to text using the OpenAI speech-to-text API or local whisper.cpp.
function convert_audio_to_text() {
  local output_file=$1

  # Local backend path: delegate to whisper.cpp and short-circuit the API
  # flow. JSONL, --pipe-to, temp_transcriptions.txt accumulation, and
  # output-file cleanup still run exactly as with the API backend.
  if [ "$BACKEND" = "local" ]; then
    local transcription display_text rc
    display_text=$(run_local_whisper_cpp "$output_file")
    rc=$?
    if [ $rc -ne 0 ] || [ -z "$display_text" ]; then
      # Skip this utterance entirely. Log the failure to stderr so the
      # user can see something went wrong, but do not pollute stdout or
      # the clipboard/file output with an error sentinel. The recording
      # loop continues with the next utterance.
      echo "Warning: local backend failed for $output_file (rc=$rc); skipping utterance" >&2
      if [ -z "$AUDIO_FILE" ]; then
        rm -f "$output_file"
      fi
      return 0
    fi
    transcription="$display_text"

    if [ "$JSONL_MODE" = true ]; then
      jq -nc \
        --argjson version "$JSONL_SCHEMA_VERSION" \
        --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --arg model "local:$(basename "$MODEL_PATH")" \
        --arg text "$display_text" \
        '{version:$version, ts:$ts, model:$model, duration:null, text:$text}'
    else
      echo "$display_text"
    fi

    if [ -n "$PIPE_TO_CMD" ]; then
      local result
      result=$(echo "$display_text" | bash -c "$PIPE_TO_CMD")
      echo "$result"
    fi

    if [ -z "$AUDIO_FILE" ]; then
      rm -f "$output_file"
    fi
    echo "$transcription" >> temp_transcriptions.txt
    return 0
  fi

  local base_url
  if [ -n "$TRANSLATE" ]; then
    base_url="https://api.openai.com/v1/audio/translations"
  else
    base_url="https://api.openai.com/v1/audio/transcriptions"
  fi

  # Determine response format based on model and options.
  # Default is plain json; verbose_json is only required when whisper-1 needs
  # to return segment/word timestamps.
  local response_format="json"
  if [ "$DIARIZE" = true ] && [[ "$MODEL" == gpt-4o-transcribe-diarize* ]]; then
    response_format="diarized_json"
  elif [ "$MODEL" = "whisper-1" ] && [ "$GRANULARITIES" != "none" ]; then
    response_format="verbose_json"
  fi

  # Write the API credentials to a private temp config file.
  # This keeps the bearer token out of the process argument list (visible via ps).
  # Using a portable template (mktemp -t has incompatible semantics on GNU vs BSD).
  local auth_file
  auth_file=$(mktemp "${TMPDIR:-/tmp}/whisper-stream.XXXXXX") || {
    echo "Error: failed to create temporary auth file" >&2
    return 1
  }
  chmod 600 "$auth_file"
  # Safety net: remove the auth file even if the function is interrupted by a
  # signal (SIGINT/SIGTERM) before the explicit cleanup at the end.
  trap 'rm -f "$auth_file"' EXIT
  printf 'header = "Authorization: Bearer %s"\n' "$TOKEN" > "$auth_file"

  # Build curl arguments as an array so that user-controlled fields
  # (PROMPT, LANGUAGE, file paths) are never re-interpreted by the shell.
  local curl_args=(
    --config "$auth_file"
    -s --request POST
    --url "$base_url"
    --form "file=@$output_file"
    --form "model=$MODEL"
    --form "response_format=$response_format"
  )

  # timestamp_granularities is only supported by whisper-1
  if [ "$GRANULARITIES" != "none" ] && [ "$MODEL" = "whisper-1" ]; then
    curl_args+=(--form "timestamp_granularities[]=${GRANULARITIES}")
  fi

  # Prompt is supported everywhere except on gpt-4o-transcribe-diarize*
  if [ -n "$PROMPT" ] && [[ "$MODEL" != gpt-4o-transcribe-diarize* ]]; then
    curl_args+=(--form "prompt=$PROMPT")
  fi

  # The /audio/translations endpoint only accepts language="en" (target).
  # Whisper auto-detects the source language, so skip the form field entirely
  # when TRANSLATE is set. If the user explicitly supplied -l, warn them.
  if [ -n "$LANGUAGE" ] && [ -z "$TRANSLATE" ]; then
    curl_args+=(--form "language=$LANGUAGE")
  fi

  # Diarization-specific parameters
  if [ "$DIARIZE" = true ] && [[ "$MODEL" == gpt-4o-transcribe-diarize* ]]; then
    curl_args+=(--form "chunking_strategy=$CHUNKING_STRATEGY")

    if [ ${#KNOWN_SPEAKERS[@]} -gt 0 ]; then
      local speakers_json="$SPEAKER_DIR/speakers.json"
      for speaker_key in "${KNOWN_SPEAKERS[@]}"; do
        local speaker_name speaker_file encoded_ref
        speaker_name=$(jq -r --arg k "$speaker_key" '.[$k].name' "$speakers_json")
        speaker_file="$SPEAKER_DIR/$(jq -r --arg k "$speaker_key" '.[$k].file' "$speakers_json")"
        if [ -f "$speaker_file" ]; then
          encoded_ref=$(encode_speaker_reference "$speaker_file")
          curl_args+=(--form "known_speaker_names[]=$speaker_name")
          curl_args+=(--form "known_speaker_references[]=$encoded_ref")
        fi
      done
    fi
  fi

  local maxretries=3
  local response=""
  local exit_code=1

  while [ $exit_code -ne 0 ] && [ $maxretries -gt 0 ]; do
    response=$(curl "${curl_args[@]}")
    exit_code=$?
    if [ $exit_code -ne 0 ]; then
      # Route progress/retry indicators to stderr, and only when we're
      # attached to a real terminal. Pipe-native mode (STDOUT_MODE) skips
      # them entirely so that callers capturing 2>&1 get a clean stream.
      if [ "$STDOUT_MODE" = false ] && [ -t 2 ]; then
        printf "\e[1;31m.\e[0m" >&2
      fi
      maxretries=$((maxretries - 1))
    fi
  done

  rm -f "$auth_file"
  trap - EXIT
  if [ "$STDOUT_MODE" = false ] && [ -t 2 ]; then
    printf "\r\e[K" >&2
  fi

  # Process response based on format
  local transcription=""
  local display_text=""

  if [ "$response_format" = "diarized_json" ]; then
    # Diarized response - format for display
    transcription="$response"

    # Extract and format segments with speaker labels
    display_text=$(echo "$response" | jq -r '
      if .segments then
        .segments[] |
        "[" + (.start | floor | tostring) + "s] " + .speaker + ": " + .text
      else
        .text // .error.message // "Error processing response"
      end
    ' 2>/dev/null)

    if [ -z "$display_text" ]; then
      # Fallback to plain text if segments not available
      display_text=$(echo "$response" | jq -r '.text // .error.message // "Error"' 2>/dev/null)
    fi

  elif [ "$GRANULARITIES" != "none" ] || [ "$response_format" = "verbose_json" ]; then
    # JSON response with granularities or verbose
    transcription="$response"
    display_text=$(echo "$response" | jq -r '.text // .error.message // "Error"' 2>/dev/null)

  else
    # Plain text or simple JSON response
    transcription=$(echo "$response" | jq -r '.text // .error.message // "Error"' 2>/dev/null)
    display_text="$transcription"
  fi

  # Primary transcription output.
  # In JSONL mode, emit one JSON object per utterance using jq so that the
  # text is properly escaped. Duration is pulled from the response when the
  # verbose_json format is in use (whisper-1 + -g); otherwise it's null.
  if [ "$JSONL_MODE" = true ]; then
    local jsonl_duration="null"
    if [ "$response_format" = "verbose_json" ]; then
      jsonl_duration=$(echo "$response" | jq -r '.duration // "null"' 2>/dev/null)
      [ -z "$jsonl_duration" ] && jsonl_duration="null"
    fi
    jq -nc \
      --argjson version "$JSONL_SCHEMA_VERSION" \
      --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      --arg model "$MODEL" \
      --argjson duration "$jsonl_duration" \
      --arg text "$display_text" \
      '{version:$version, ts:$ts, model:$model, duration:$duration, text:$text}'
  else
    echo "$display_text"
  fi

  if [ -n "$PIPE_TO_CMD" ]; then
    # PIPE_TO_CMD is intentionally interpreted as a shell command, because the
    # -p2 option exists specifically so users can supply shell pipelines like
    # "wc -w". Unlike PROMPT/LANGUAGE (opaque data sent to the API), this value
    # is expected to be executed by the user's shell.
    result=$(echo "$display_text" | bash -c "$PIPE_TO_CMD")
    echo "$result"
  fi

  # Remove the output audio file unless the `-f` option is specified
  if [ -z "$AUDIO_FILE" ]; then
    rm -f "$output_file"
  fi

  # Accumulate the transcribed text in a temporary file
  # this is necessary for the data to be available when the script terminates
  echo "$transcription" >> temp_transcriptions.txt
}

# Handle the script termination: clean up and save transcriptions
function handle_exit() {
  # Wait for all background jobs to finish
  wait

  # Kill all child processes
  pkill -P $$

  # Remove all output audio files
  for file in "${output_files[@]}"; do
    rm -f "$file"
  done

  # if temp_transcriptions.txt exists, remove it
  if [ -f temp_transcriptions.txt ]; then
    # read data from temp_transcriptions.txt into the accumulated_text variable
    # and remove temp_transcriptions.txt
    accumulated_text=$(cat temp_transcriptions.txt)
    rm -f temp_transcriptions.txt
    # Clear the current line (after the spinner). Only do this when attached
    # to a real terminal AND not in pipe-native mode — otherwise the escape
    # sequence pollutes a piped stdout stream and breaks jq/sed/etc.
    if [ "$STDOUT_MODE" = false ] && [ -t 1 ]; then
      printf "\r\e[K\n"
    fi
  else
    if [ "$STDOUT_MODE" = false ] && [ -t 1 ]; then
      printf "\r\e[K"
    fi
    exit
  fi

  # In pipe-native mode, skip all side effects: no file saving, no clipboard,
  # no "copied" confirmation. The transcriptions already went to stdout.
  if [ "$STDOUT_MODE" = true ]; then
    exit
  fi

  # If output directory is specified, create a file with the accumulated text in the specified directory
  if [ -n "$OUTPUT_DIR" ]; then
    timestamp=$(date +"%Y-%m-%d_%H-%M-%S")
    # Determine file extension based on content type
    if [ "$DIARIZE" = true ] || [ "$GRANULARITIES" != "none" ]; then
      # JSON output for diarization or granularities
      echo "$accumulated_text" > "$OUTPUT_DIR/transcription_$timestamp.json"
    else
      # Plain text output
      echo "$accumulated_text" > "$OUTPUT_DIR/transcription_$timestamp.txt"
    fi
  fi

  # Copy the accumulated text to the clipboard
  case "$(uname -s)" in
    Darwin)
      # if $accumulated_text is not empty
      if [ -n "$accumulated_text" ]; then
        echo "$accumulated_text" > temp.txt
        cat temp.txt | pbcopy
        rm temp.txt
        echo $'\e[0;36m'Transcription copied to clipboard.$'\e[0m'
      fi
      ;;
    Linux)
      echo "$accumulated_text" | xclip -selection clipboard >&1
      ;;
    CYGWIN*|MINGW32*|MSYS*|MINGW*)
      # This is a rough guess that you're on Windows Subsystem for Linux
      # if $accumulated_text is not empty
      if [ -n "$accumulated_text" ]; then
        echo "$accumulated_text" | clip.exe >&1
        echo $'\e[0;36m'Transcription copied to clipboard.$'\e[0m'
      fi
      ;;
    *)
      echo "Unknown OS, cannot copy to clipboard"
      ;;
  esac

  exit
}

# Library mode: skip main execution (file mode + recording loop).
# Function definitions above are still sourced normally.
if [[ "${WHISPER_STREAM_LIB:-0}" != "1" ]]; then

# If an audio file is provided, convert it to text and then exit
if [ -n "$AUDIO_FILE" ]; then

  # Handle speaker registration if requested
  if [ "$REGISTER_SPEAKERS" = true ] || ([ "$DIARIZE" = true ] && [ "$MODEL" = "gpt-4o-transcribe-diarize" ]); then
    if [ "$REGISTER_SPEAKERS" = true ]; then
      # Explicit speaker registration requested
      register_speakers_interactive
    else
      # Diarization without explicit registration - offer to register
      if [ "$QUIET_MODE" = false ]; then
        echo ""
        echo "Diarization mode enabled."
        echo "Register known speakers? (y/N): "
        read -r register_choice
        if [[ "$register_choice" =~ ^[Yy]$ ]]; then
          register_speakers_interactive
        fi
      fi
    fi
  fi

  # print banner and settings unless quiet mode is enabled
  # this is necessary for the data to be available when the script terminates
  if [ "$QUIET_MODE" = false ]; then
    echo ""
    echo $'\e[1;34m'Whisper Stream Transcriber$'\e[0m' ${VERSION}
    echo $'\e[1;33m'-----------------------------------------------$'\e[0m'
    echo "Current settings:"
    echo "  Backend: $BACKEND"
    if [ "$BACKEND" = "local" ]; then
      echo "  Model: $(basename "$MODEL_PATH")"
    else
      echo "  Model: $MODEL"
    fi
    echo "  Input language: ${LANGUAGE:-Not specified}"

    if [ -n "$TRANSLATE" ]; then
      echo "  Translate to English: $TRANSLATE"
    fi

    if [ "$DIARIZE" = true ]; then
      echo "  Diarization: enabled"
      if [ ${#KNOWN_SPEAKERS[@]} -gt 0 ]; then
        echo "  Known speakers: ${#KNOWN_SPEAKERS[@]}"
      fi
    fi

    if [ -n "$OUTPUT_DIR" ]; then
      echo "  Output Dir: $OUTPUT_DIR"
    fi

    echo "  Input file: $AUDIO_FILE"
    echo $'\e[1;33m'-----------------------------------------------$'\e[0m'
    echo $'\e[0;36m'Please wait ...$'\e[0m'
    echo ""
  fi

  convert_audio_to_text "$AUDIO_FILE"
  handle_exit
fi

# Display the current configuration/settings of the script
display_settings

# Handle script termination using trap for SIGINT (Ctrl+C) and SIGTSTP (Ctrl+Z)
trap handle_exit SIGINT SIGTSTP

# Main loop to continuously record audio, detect silence, and transcribe audio
while true; do
  # Set the path to the output audio file
  OUTPUT_FILE="output_$(date +%s).mp3"
  
  # Add the output file to the array
  output_files+=("$OUTPUT_FILE")

  # Add a prompt at the beginning of the recording
  # echo -n $'\e[1;32m'▶ $'\e[0m'

  # Record audio in raw format then convert to mp3
  if [ "$DURATION" -gt 0 ]; then
    rec -q -V0 -e signed -L -c 1 -b 16 -r 44100 -t raw \
      - trim 0 "$DURATION" silence 1 0.1 "$MIN_VOLUME" 1 "$SILENCE_LENGTH" "$MIN_VOLUME" | \
      sox -t raw -r 44100 -b 16 -e signed -c 1 - "$OUTPUT_FILE"
  else
    rec -q -V0 -e signed -L -c 1 -b 16 -r 44100 -t raw \
      - silence 1 0.1 "$MIN_VOLUME" 1 "$SILENCE_LENGTH" "$MIN_VOLUME" | \
      sox -t raw -r 44100 -b 16 -e signed -c 1 - "$OUTPUT_FILE"
  fi
  
  # Check if the audio file is created successfully
  if [ -s "$OUTPUT_FILE" ]; then
    if [ "$BACKEND" = "local" ]; then
      # Local backend: run whisper-cli synchronously. Running multiple
      # whisper-cli invocations in parallel contends for GPU/CPU and can
      # destabilize Metal on Apple Silicon. Serial execution keeps the
      # load predictable at the cost of slightly higher latency when
      # utterances arrive faster than whisper-cli can process them.
      convert_audio_to_text "$OUTPUT_FILE"
    else
      # API backend: curl is lightweight and network-bound, so run in the
      # background and show a spinner while we record the next utterance.
      convert_audio_to_text "$OUTPUT_FILE" &
      pid=$!
      # Only show the spinner when stdout is a real terminal and we are
      # not in pipe-native mode — a spinner emitted into a pipe corrupts
      # downstream consumers (jq, sed, named pipes, etc.).
      if [ "$STDOUT_MODE" = false ] && [ -t 1 ]; then
        spinner $pid &
      fi
    fi
  else
    echo "No audio recorded." >&2
  fi

  if [ "$ONESHOT" = true ]; then
    break
  fi
done

# Handle final cleanup and exit
handle_exit

fi  # end library-mode guard: end of main execution block
