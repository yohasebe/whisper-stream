SILENCE_LENGTH=1.5             # Minimum silence duration in seconds
ONESHOT=false                  # Flag to determine if the script should run once or continuously
DURATION=0                     # Duration of the recording in seconds (0 means continuous)
MIN_AUDIO_DURATION=0.3         # Skip utterances shorter than this many seconds
MODEL="gpt-transcribe"         # Model name for the API backend
MODEL_SET=false                # True when -m was given (the local backend warns that it is ignored)
TOKEN=""                       # OpenAI API token (optional when --api-url points to a non-OpenAI endpoint)
OUTPUT_DIR=""                  # Directory to save the transcriptions
PROMPT=""                      # Prompt for the API call
LANGUAGE=""                    # Language code(s) for transcription; comma-separated for several
declare -a LANGUAGES=()        # LANGUAGE split into codes (parse_language_list)
declare -a KEYWORDS=()         # Terms expected in the audio (--keyword / --keywords-file; gpt-transcribe)
TRANSLATE=""                   # Flag to translate to English (local backend only since v3.0)
AUDIO_FILE=""                  # Specific audio file for transcription
PIPE_TO_CMD=""                 # Command to pipe the transcribed text to
QUIET_MODE=false               # Flag to determine if the banner and settings should be suppressed
STDOUT_MODE=false              # Pipe-native mode: transcript-only output, no clipboard/file side effects
JSONL_MODE=false               # Emit one JSON object per utterance (implies STDOUT_MODE)
JSONL_SCHEMA_VERSION=1         # Schema version for JSONL output; bump on breaking changes
                               # (added fields such as seq/languages are not breaking)

# OpenAI removes the gpt-4o-* transcription models and whisper-1 on this date
# (deprecation notice of 2026-08-26). Used in the startup warnings.
OPENAI_LEGACY_STT_SHUTDOWN="2027-02-26"

# Backend selection
BACKEND="api"                  # "api" (OpenAI or compatible) or "local" (whisper.cpp)
MODEL_PATH=""                  # Path to ggml model file for local backend
API_URL=""                     # Override the API endpoint (e.g., http://127.0.0.1:2022/v1/audio/transcriptions for whisper-server)
API_TIMEOUT=""                 # Per-attempt request time limit in seconds (--api-timeout; empty: 120, or 600 with -f)
API_MAX_ATTEMPTS=3             # Requests per utterance, including the first
API_RETRY_BASE_DELAY=1         # Backoff before the 2nd attempt in seconds; doubles each time
API_RETRY_MAX_WAIT=60          # Give up rather than wait longer than this for a server-requested retry
MAX_JOBS=4                     # Concurrent API requests in real-time mode (--max-jobs)
MAX_QUEUE=100                  # Recorded utterances waiting for a worker; recording pauses when full
VAD=false                     # Use whisper.cpp's built-in VAD to filter non-speech (local backend only)
VAD_MODEL_PATH=""              # Path to the VAD model (silero) file
WHISPER_CLI="whisper-cli"      # Resolved whisper-cli command (set by validate_config)
# Homebrew opt paths exist even when the whisper-cpp keg is UNLINKED, which
# happens after `brew upgrade whisper-cpp` because that formula ships a
# binary also named `whisper-stream` and the link conflicts with this tool.
WHISPER_CLI_FALLBACKS=(
  /opt/homebrew/opt/whisper-cpp/bin/whisper-cli
  /usr/local/opt/whisper-cpp/bin/whisper-cli
)

# Diarization settings (for gpt-4o-transcribe-diarize)
DIARIZE=false                  # Enable speaker diarization
REGISTER_SPEAKERS=false        # Interactively register known speakers
LIST_SPEAKERS=false            # List saved speaker samples
DELETE_SPEAKER=""              # Speaker name to delete
SPEAKER_DIR="$HOME/.whisper-stream/speakers"  # Directory for speaker samples
CHUNKING_STRATEGY=""           # Chunking strategy for diarization (auto or vad)
declare -a KNOWN_SPEAKERS=()   # Array of known speaker names to use

