# Check the validity of the provided audio file
function check_audio_file() {
  local file=$1
  local max_size=${2:-26214400}  # Default 25MB (OpenAI API limit)

  # Check if the file exists
  if [ ! -f "$file" ]; then
    echo "File does not exist: $file"
    exit 1
  fi

  # Check if the file is not empty
  if [ ! -s "$file" ]; then
    echo "File is empty: $file"
    exit 1
  fi

  # The size limit and the extension whitelist below are OpenAI API
  # constraints. The local backend (whisper-cli) has neither, so for it an
  # existing non-empty file is enough.
  if [ "$BACKEND" = "local" ]; then
    return 0
  fi

  # Check if the file size is under limit
  local filesize
  if [[ "$OSTYPE" == "linux-gnu"* ]]; then
    filesize=$(stat -c%s "$file")
  elif [[ "$OSTYPE" == "darwin"* ]]; then
    filesize=$(stat -f%z "$file")
  else
    echo "Unknown operating system"
    exit 1
  fi
  if [ $filesize -gt $max_size ]; then
    echo "File size is over limit: $file"
    exit 1
  fi

  # Check if the file format is acceptable (case-insensitive)
  local ext
  ext=$(printf '%s' "${file##*.}" | tr '[:upper:]' '[:lower:]')
  case "$ext" in
    m4a|mp3|webm|mp4|mpga|wav|mpeg|flac|ogg|opus)
      ;;
    *)
      echo "File format is not acceptable: $file"
      exit 1
      ;;
  esac
}

# List saved speaker samples
function list_speakers() {
  local speakers_json="$SPEAKER_DIR/speakers.json"

  if [ ! -f "$speakers_json" ]; then
    echo "No saved speaker samples found."
    echo "Speaker directory: $SPEAKER_DIR"
    exit 0
  fi

  echo ""
  echo "Saved speaker library ($SPEAKER_DIR):"
  echo "-----------------------------------------------"

  # Use jq to parse and display speakers
  if command -v jq &> /dev/null; then
    local count=0
    while IFS= read -r speaker; do
      count=$((count + 1))
      local name=$(echo "$speaker" | jq -r '.name')
      local duration=$(echo "$speaker" | jq -r '.duration')
      local created=$(echo "$speaker" | jq -r '.created')
      printf "  %d) %-15s (%.1fs, created %s)\n" "$count" "$name" "$duration" "$created"
    done < <(jq -c '.[]' "$speakers_json")
    echo ""
    echo "Total: $count speaker(s)"
  else
    cat "$speakers_json"
  fi
  echo ""
  exit 0
}

# Delete a speaker sample
function delete_speaker() {
  local speaker_name=$1
  local speakers_json="$SPEAKER_DIR/speakers.json"
  local speaker_key=$(echo "$speaker_name" | tr '[:upper:]' '[:lower:]' | tr -d ' ')

  if [ ! -f "$speakers_json" ]; then
    echo "No saved speaker samples found."
    exit 1
  fi

  # Check if speaker exists (use --arg to avoid jq-injection via exotic names)
  if ! jq -e --arg k "$speaker_key" '.[$k]' "$speakers_json" &> /dev/null; then
    echo "Speaker '$speaker_name' not found."
    exit 1
  fi

  # Get file path
  local audio_file="$SPEAKER_DIR/$(jq -r --arg k "$speaker_key" '.[$k].file' "$speakers_json")"

  # Confirm deletion
  echo "Delete speaker '$speaker_name'? (y/N): "
  read -r confirm
  if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
    echo "Deletion cancelled."
    exit 0
  fi

  # Remove from JSON
  jq --arg k "$speaker_key" 'del(.[$k])' "$speakers_json" > "${speakers_json}.tmp" && mv "${speakers_json}.tmp" "$speakers_json"

  # Remove audio file
  if [ -f "$audio_file" ]; then
    rm -f "$audio_file"
  fi

  echo "✓ Deleted speaker '$speaker_name'"
  exit 0
}

# Initialize speaker directory
function init_speaker_dir() {
  if [ ! -d "$SPEAKER_DIR" ]; then
    mkdir -p "$SPEAKER_DIR"
  fi

  local speakers_json="$SPEAKER_DIR/speakers.json"
  if [ ! -f "$speakers_json" ]; then
    echo "{}" > "$speakers_json"
  fi
}

# Record a speaker sample
function record_speaker_sample() {
  local speaker_name=$1
  local speaker_key=$(echo "$speaker_name" | tr '[:upper:]' '[:lower:]' | tr -d ' ')
  local output_file="$SPEAKER_DIR/${speaker_key}.wav"

  echo ""
  echo "Recording sample for '$speaker_name'..."
  echo "Recommended: 2-10 seconds of clear speech"
  echo ""
  echo "Recording duration in seconds (default: 5): "
  read -r duration
  duration=${duration:-5}

  # Validate duration
  if ! [[ "$duration" =~ ^[0-9]+$ ]] || [ "$duration" -lt 2 ] || [ "$duration" -gt 10 ]; then
    echo "Warning: Duration should be between 2-10 seconds for best results."
    echo "Continue with $duration seconds? (Y/n): "
    read -r confirm
    if [[ "$confirm" =~ ^[Nn]$ ]]; then
      return 1
    fi
  fi

  echo ""
  echo "Press ENTER to start ${duration}-second recording for '$speaker_name'..."
  read -r

  echo "🔴 Recording..."

  # Record audio
  rec -q -V0 -c 1 -r 44100 "$output_file" trim 0 "$duration" 2>/dev/null

  if [ ! -s "$output_file" ]; then
    echo "Error: Recording failed"
    return 1
  fi

  # Get actual duration. soxi ships with SoX which is already a hard
  # dependency of this script, so no existence check is needed.
  local actual_duration
  actual_duration=$(soxi -D "$output_file" 2>/dev/null)
  actual_duration=${actual_duration:-$duration}

  echo "✓ Recording complete (${actual_duration}s)"
  echo ""
  echo "Is this sample OK? (y/n/r for retry): "
  read -r confirm

  case "$confirm" in
    [Yy])
      # Save to speakers.json
      local speakers_json="$SPEAKER_DIR/speakers.json"
      local timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

      jq --arg key "$speaker_key" \
         --arg name "$speaker_name" \
         --arg file "${speaker_key}.wav" \
         --arg duration "$actual_duration" \
         --arg created "$timestamp" \
         '. + {($key): {name: $name, file: $file, duration: ($duration | tonumber), created: $created}}' \
         "$speakers_json" > "${speakers_json}.tmp" && mv "${speakers_json}.tmp" "$speakers_json"

      echo "✓ Sample saved to $output_file"
      echo "✓ Speaker '$speaker_name' registered"
      return 0
      ;;
    [Rr])
      rm -f "$output_file"
      record_speaker_sample "$speaker_name"
      return $?
      ;;
    *)
      rm -f "$output_file"
      echo "Sample discarded."
      return 1
      ;;
  esac
}

# Interactive speaker registration
function register_speakers_interactive() {
  init_speaker_dir

  local speakers_json="$SPEAKER_DIR/speakers.json"

  echo ""
  echo "=== Speaker Registration ==="
  echo ""

  # Check for existing speakers
  local existing_count=0
  if [ -f "$speakers_json" ]; then
    existing_count=$(jq 'length' "$speakers_json" 2>/dev/null || echo 0)
  fi

  if [ "$existing_count" -gt 0 ]; then
    echo "Found $existing_count saved speaker sample(s):"
    local idx=1
    while IFS= read -r speaker; do
      local name=$(echo "$speaker" | jq -r '.name')
      local duration=$(echo "$speaker" | jq -r '.duration')
      local created=$(echo "$speaker" | jq -r '.created')
      printf "  %d) %-15s (%.1fs, %s)\n" "$idx" "$name" "$duration" "$created"
      idx=$((idx + 1))
    done < <(jq -c '.[]' "$speakers_json")
    echo ""

    echo "Options:"
    echo "  a) Use all saved speakers"
    echo "  s) Select specific speakers"
    echo "  n) Register new speakers"
    echo "  d) Delete saved speakers"
    echo "Choice (a/s/n/d): "
    read -r choice

    case "$choice" in
      [Aa])
        # Use all speakers
        while IFS= read -r key; do
          KNOWN_SPEAKERS+=("$key")
        done < <(jq -r 'keys[]' "$speakers_json")
        echo "✓ Using all saved speakers"
        return 0
        ;;
      [Ss])
        # Select specific speakers
        echo ""
        echo "Select speakers (space-separated numbers, e.g., '1 2'): "
        read -r selections

        for num in $selections; do
          # Skip non-numeric input instead of tripping arithmetic expansion.
          [[ "$num" =~ ^[0-9]+$ ]] || continue
          local key
          key=$(jq -r --argjson i "$((num - 1))" 'keys[$i]' "$speakers_json" 2>/dev/null)
          if [ -n "$key" ] && [ "$key" != "null" ]; then
            KNOWN_SPEAKERS+=("$key")
          fi
        done

        if [ ${#KNOWN_SPEAKERS[@]} -gt 0 ]; then
          echo "✓ Selected ${#KNOWN_SPEAKERS[@]} speaker(s)"
        fi

        echo ""
        echo "Register additional new speakers? (y/N): "
        read -r add_new
        if [[ ! "$add_new" =~ ^[Yy]$ ]]; then
          return 0
        fi
        ;;
      [Dd])
        # Delete speakers
        echo ""
        echo "Select speakers to delete (space-separated numbers): "
        read -r selections

        for num in $selections; do
          local key
          key=$(jq -r --argjson i "$((num - 1))" 'keys[$i]' "$speakers_json")
          if [ "$key" != "null" ]; then
            local name file
            name=$(jq -r --arg k "$key" '.[$k].name' "$speakers_json")
            file=$(jq -r --arg k "$key" '.[$k].file' "$speakers_json")

            echo "Delete '$name'? (y/N): "
            read -r confirm
            if [[ "$confirm" =~ ^[Yy]$ ]]; then
              jq --arg k "$key" 'del(.[$k])' "$speakers_json" > "${speakers_json}.tmp" && mv "${speakers_json}.tmp" "$speakers_json"
              rm -f "$SPEAKER_DIR/$file"
              echo "✓ Deleted '$name'"
            fi
          fi
        done

        echo ""
        echo "Register new speakers? (y/N): "
        read -r add_new
        if [[ ! "$add_new" =~ ^[Yy]$ ]]; then
          exit 0
        fi
        ;;
      [Nn])
        # Continue to register new speakers
        ;;
      *)
        echo "Invalid choice"
        return 1
        ;;
    esac
  fi

  # Register new speakers
  local current_count=${#KNOWN_SPEAKERS[@]}
  local max_new=$((4 - current_count))

  if [ $max_new -le 0 ]; then
    echo "Maximum of 4 speakers already selected."
    return 0
  fi

  echo ""
  echo "How many new speakers to register? (1-$max_new): "
  read -r num_speakers

  if ! [[ "$num_speakers" =~ ^[0-9]+$ ]] || [ "$num_speakers" -lt 1 ] || [ "$num_speakers" -gt "$max_new" ]; then
    echo "Invalid number"
    return 1
  fi

  for ((i=1; i<=num_speakers; i++)); do
    echo ""
    echo "=== Registering Speaker $i/$num_speakers ==="
    echo "Enter speaker name: "
    read -r speaker_name

    if [ -z "$speaker_name" ]; then
      echo "Error: Speaker name cannot be empty"
      ((i--))
      continue
    fi

    if record_speaker_sample "$speaker_name"; then
      local speaker_key=$(echo "$speaker_name" | tr '[:upper:]' '[:lower:]' | tr -d ' ')
      KNOWN_SPEAKERS+=("$speaker_key")
    else
      echo "Failed to register speaker. Try again? (y/N): "
      read -r retry
      if [[ "$retry" =~ ^[Yy]$ ]]; then
        ((i--))
      fi
    fi
  done

  echo ""
  echo "✓ Speaker registration complete"
  echo "Total speakers: ${#KNOWN_SPEAKERS[@]}"
}

# Encode speaker reference to base64 data URL
function encode_speaker_reference() {
  local audio_file=$1

  if [[ "$OSTYPE" == "darwin"* ]]; then
    echo "data:audio/wav;base64,$(base64 -i "$audio_file")"
  else
    echo "data:audio/wav;base64,$(base64 -w 0 "$audio_file")"
  fi
}

# Resolve the whisper-cli command: PATH first, then the Homebrew opt-path
# fallbacks (see WHISPER_CLI_FALLBACKS above). Echoes the command to use;
# returns non-zero when whisper-cli cannot be found anywhere.
function resolve_whisper_cli() {
  if command -v whisper-cli >/dev/null 2>&1; then
    echo "whisper-cli"
    return 0
  fi
  local candidate
  for candidate in "${WHISPER_CLI_FALLBACKS[@]}"; do
    if [ -x "$candidate" ]; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

# True when requests go to OpenAI itself. OpenAI's model rules (removal
# dates, realtime-only models, retired names) do not apply to a self-hosted
# server behind --api-url.
function is_openai_endpoint() {
  [ -z "$API_URL" ] || [[ "$API_URL" == https://api.openai.com/* ]]
}

# Models that take the plural `languages[]` and `keywords[]` fields.
function model_takes_context_fields() {
  [[ "$MODEL" == gpt-transcribe* ]]
}

# Models known NOT to take `languages[]` / `keywords[]`: they accept only the
# singular `language` field. Unknown names are neither, and get a best effort.
function model_is_legacy_openai() {
  [[ "$MODEL" == gpt-4o-transcribe* || "$MODEL" == gpt-4o-mini-transcribe* || "$MODEL" == whisper-1* ]]
}

# Split LANGUAGE ("en", "en,ja", " en , ja ") into the LANGUAGES array.
# Returns 1 when a list member is empty (e.g. "en,,ja" or a trailing comma)
# or the value contains a line break (`read` would drop everything after it).
function parse_language_list() {
  LANGUAGES=()
  [ -z "$LANGUAGE" ] && return 0
  [[ "$LANGUAGE" == *[$'\r\n']* ]] && return 1
  local -a parts=()
  local part
  IFS=',' read -ra parts <<< "$LANGUAGE"
  # `read -a` drops one trailing empty field; catch "en," explicitly.
  [[ "$LANGUAGE" == *, ]] && return 1
  for part in "${parts[@]}"; do
    part="${part#"${part%%[![:space:]]*}"}"
    part="${part%"${part##*[![:space:]]}"}"
    [ -z "$part" ] && return 1
    LANGUAGES+=("$part")
  done
  return 0
}

# The API rejects the whole request, with only "Invalid request.", when a
# keyword is empty or contains `<`, `>`, CR, or LF. Check before sending.
function keyword_is_valid() {
  local kw=$1
  [ -n "$kw" ] && [[ "$kw" != *[$'<>\r\n']* ]]
}

# Append the terms in a keywords file to KEYWORDS: one term per line, CRLF
# accepted, surrounding whitespace trimmed, blank lines skipped.
function load_keywords_file() {
  local file=$1
  if [ ! -r "$file" ] || [ -d "$file" ]; then
    echo "Error: cannot read keywords file: $file" >&2
    exit 1
  fi
  local line lineno=0
  while IFS= read -r line || [ -n "$line" ]; do
    lineno=$((lineno + 1))
    line="${line%$'\r'}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [ -z "$line" ] && continue
    if ! keyword_is_valid "$line"; then
      echo "Error: $file line $lineno: keywords must not contain '<' or '>': $line" >&2
      exit 1
    fi
    KEYWORDS+=("$line")
  done < "$file"
}

# Validate configuration and warn on unrecognized models.
# Uses glob patterns so that snapshot names (e.g. gpt-4o-mini-transcribe-2025-12-15)
# pass through to the API without being blocked by a hard-coded whitelist.
function validate_config() {
  case "$BACKEND" in
    api|local) ;;
    *)
      echo "Error: Invalid backend '$BACKEND'. Must be 'api' or 'local'." >&2
      exit 1
      ;;
  esac

  # Required external commands, by mode. jq is needed in every mode (API
  # response parsing, speaker metadata); curl only for the api backend;
  # rec/sox only for real-time recording — file mode (-f) never invokes
  # them, so it keeps working on machines without audio hardware.
  if ! command -v jq >/dev/null 2>&1; then
    echo "Error: 'jq' not found in PATH." >&2
    echo "Hint: brew install jq (macOS) / sudo apt-get install jq (Debian/Ubuntu)" >&2
    exit 1
  fi
  if [ "$BACKEND" = "api" ] && ! command -v curl >/dev/null 2>&1; then
    echo "Error: 'curl' not found in PATH (required by the api backend)." >&2
    exit 1
  fi
  if [ -z "$AUDIO_FILE" ]; then
    local -a missing_recorders=()
    command -v rec >/dev/null 2>&1 || missing_recorders+=("rec")
    command -v sox >/dev/null 2>&1 || missing_recorders+=("sox")
    if [ ${#missing_recorders[@]} -gt 0 ]; then
      echo "Error: '${missing_recorders[*]}' not found in PATH (required for real-time recording)." >&2
      echo "Hint: brew install sox (macOS) / sudo apt-get install sox (Debian/Ubuntu)" >&2
      exit 1
    fi
  fi
  # Clipboard is best-effort: warn only when its absence could lose data
  # (non-stdout mode without an output directory). handle_exit falls back
  # to a file save, so this is not fatal.
  if [[ "$OSTYPE" == "linux-gnu"* ]] && [ "$STDOUT_MODE" != true ] && [ -z "$OUTPUT_DIR" ] \
     && ! command -v xclip >/dev/null 2>&1; then
    echo "Warning: 'xclip' not found; transcriptions will be saved to a file on exit instead of the clipboard." >&2
    echo "Hint: sudo apt-get install xclip" >&2
  fi

  # -p2 output and pipe-native output share stdout; the interleaved result
  # breaks downstream parsers (jq, sed, ...).
  if [ -n "$PIPE_TO_CMD" ] && [ "$STDOUT_MODE" = true ]; then
    echo "Warning: --pipe-to output is interleaved with --stdout/--jsonl output; downstream parsers may break." >&2
  fi

  # Warn when backend-specific options are set for the wrong backend.
  # Only fires when the value is non-default so we avoid noise.
  if [ "$BACKEND" = "local" ] && [ "$MODEL_SET" = true ]; then
    echo "Warning: -m/--model is ignored when --backend local is used; use --model-path to select a ggml model." >&2
  fi
  if [ "$BACKEND" = "api" ] && [ -n "$MODEL_PATH" ]; then
    echo "Warning: --model-path is ignored when --backend api is used." >&2
  fi
  if [ "$BACKEND" = "local" ] && [ -n "$API_URL" ]; then
    echo "Warning: --api-url is ignored when --backend local is used." >&2
  fi
  if [ "$BACKEND" = "local" ] && [ -n "$API_TIMEOUT" ]; then
    echo "Warning: --api-timeout is ignored when --backend local is used." >&2
  fi
  if [ "$BACKEND" = "api" ] && [ "$VAD" = true ]; then
    echo "Error: --vad is only supported by the local backend (whisper.cpp)." >&2
    exit 1
  fi

  # -l accepts a comma-separated list; --keyword values are literal terms.
  if ! parse_language_list; then
    echo "Error: invalid --language list: '$LANGUAGE' (use comma-separated codes such as 'en,ja')" >&2
    exit 1
  fi
  local i
  for i in "${!KEYWORDS[@]}"; do
    if ! keyword_is_valid "${KEYWORDS[$i]}"; then
      echo "Error: keyword $((i + 1)) is empty or contains '<', '>', or a line break: '${KEYWORDS[$i]}'" >&2
      exit 1
    fi
  done

  # Local backend feature compatibility.
  if [ "$BACKEND" = "local" ]; then
    if [ ${#LANGUAGES[@]} -gt 1 ]; then
      echo "Error: the local backend accepts a single --language (whisper-cli -l)" >&2
      exit 1
    fi
    if [ ${#KEYWORDS[@]} -gt 0 ]; then
      echo "Error: --keyword / --keywords-file are not supported by the local backend" >&2
      exit 1
    fi
    if [ "$DIARIZE" = true ]; then
      echo "Error: --diarize is not supported by the local backend" >&2
      exit 1
    fi
    if [ "$REGISTER_SPEAKERS" = true ]; then
      echo "Error: --register-speakers is not supported by the local backend" >&2
      exit 1
    fi
    # Resolve model path: CLI flag > env var > default location
    if [ -z "$MODEL_PATH" ]; then
      MODEL_PATH="${WHISPER_STREAM_MODEL:-$HOME/.whisper-stream/models/ggml-base.en.bin}"
    fi
    if [ ! -f "$MODEL_PATH" ]; then
      echo "Error: whisper.cpp model not found at: $MODEL_PATH" >&2
      echo "Hint: download a ggml model from https://huggingface.co/ggerganov/whisper.cpp" >&2
      echo "      and place it there, or set \$WHISPER_STREAM_MODEL / --model-path." >&2
      exit 1
    fi
    if ! WHISPER_CLI=$(resolve_whisper_cli); then
      echo "Error: 'whisper-cli' binary not found in PATH or Homebrew opt paths." >&2
      echo "Hint: install whisper.cpp with 'brew install whisper-cpp' (macOS)" >&2
      echo "      or build from https://github.com/ggml-org/whisper.cpp" >&2
      exit 1
    fi
    # Resolve VAD model path when --vad is enabled.
    if [ "$VAD" = true ]; then
      if [ -z "$VAD_MODEL_PATH" ]; then
        VAD_MODEL_PATH="${WHISPER_STREAM_VAD_MODEL:-$HOME/.whisper-stream/models/ggml-silero-v5.1.2.bin}"
      fi
      if [ ! -f "$VAD_MODEL_PATH" ]; then
        echo "Error: VAD model not found at: $VAD_MODEL_PATH" >&2
        echo "Hint: download a silero VAD model from" >&2
        echo "      https://huggingface.co/ggml-org/whisper-vad/" >&2
        echo "      and place it there, or set \$WHISPER_STREAM_VAD_MODEL / --vad-model-path." >&2
        exit 1
      fi
    fi
    return 0
  fi

  # API backend validation below. Model names are recognised by glob so that
  # dated snapshots pass; OpenAI-specific rules are skipped for --api-url
  # servers, which accept whatever model names they like.
  if is_openai_endpoint; then
    case "$MODEL" in
      gpt-transcribe*)
        ;;
      gpt-4o-transcribe-diarize*)
        echo "Warning: $MODEL will be removed from the OpenAI API on $OPENAI_LEGACY_STT_SHUTDOWN." >&2
        echo "         OpenAI has not announced a replacement that keeps speaker labels," >&2
        echo "         so --diarize will stop working then." >&2
        ;;
      gpt-4o-mini-transcribe-2025-03-20)
        echo "Warning: $MODEL will be removed from the OpenAI API on 2027-01-20." >&2
        echo "         Use gpt-transcribe (the default) instead." >&2
        ;;
      gpt-4o-transcribe*|gpt-4o-mini-transcribe*)
        echo "Warning: $MODEL will be removed from the OpenAI API on $OPENAI_LEGACY_STT_SHUTDOWN." >&2
        echo "         Use gpt-transcribe (the default) instead." >&2
        ;;
      whisper-1*)
        echo "Error: whisper-1 is not supported by whisper-stream since v3.0." >&2
        echo "       (OpenAI removes it from the API on $OPENAI_LEGACY_STT_SHUTDOWN.)" >&2
        echo "       Use gpt-transcribe (the default) instead." >&2
        echo "       For translation to English, use --backend local with --translate." >&2
        exit 1
        ;;
      gpt-live-transcribe*|gpt-realtime-whisper*)
        echo "Error: $MODEL is a Realtime-session model and does not work with" >&2
        echo "       /v1/audio/transcriptions. Use gpt-transcribe (the default) instead." >&2
        exit 1
        ;;
      *)
        echo "Warning: Unrecognized model '$MODEL'. Passing through to API." >&2
        ;;
    esac
  fi

  # Language and keyword fields depend on the model. gpt-transcribe takes the
  # plural fields; the gpt-4o-* models take one `language` and no keywords.
  # Unknown models get the plural fields only when they are needed.
  if model_is_legacy_openai; then
    if [ ${#LANGUAGES[@]} -gt 1 ]; then
      echo "Error: several --language codes require gpt-transcribe; $MODEL accepts one" >&2
      exit 1
    fi
    if [ ${#KEYWORDS[@]} -gt 0 ]; then
      echo "Error: --keyword / --keywords-file require gpt-transcribe; $MODEL does not support them" >&2
      exit 1
    fi
  fi

  # Translation has been local-only since v3.0: the OpenAI
  # /audio/translations endpoint needs whisper-1, which whisper-stream no
  # longer supports. whisper.cpp's whisper-cli translates natively.
  if [ -n "$TRANSLATE" ]; then
    echo "Error: --translate is only supported by the local backend (whisper.cpp) since v3.0." >&2
    echo "       Use: --backend local --translate" >&2
    exit 1
  fi

  if [ "$DIARIZE" = true ] && [[ "$MODEL" != gpt-4o-transcribe-diarize* ]]; then
    echo "Error: --diarize option requires model gpt-4o-transcribe-diarize"
    exit 1
  fi

  if [ "$REGISTER_SPEAKERS" = true ]; then
    if [[ "$MODEL" != gpt-4o-transcribe-diarize* ]]; then
      echo "Error: --register-speakers requires model gpt-4o-transcribe-diarize"
      exit 1
    fi
    if [ -z "$AUDIO_FILE" ]; then
      echo "Error: --register-speakers is only available in file mode (-f)"
      echo "For real-time mode, automatic speaker labels (Speaker A, B, C) will be used."
      exit 1
    fi
    DIARIZE=true
  fi

  if [ "$DIARIZE" = true ]; then
    CHUNKING_STRATEGY="auto"
  fi

  # JSONL output cannot represent diarized_json's per-segment speaker structure
  # cleanly in a single per-utterance JSON object. Reject the combination for
  # now and revisit when a v2 schema is designed.
  if [ "$JSONL_MODE" = true ] && [ "$DIARIZE" = true ]; then
    echo "Error: --jsonl is not compatible with --diarize (schema v1)" >&2
    exit 1
  fi
}

# Library mode: tests source this script to call functions in isolation.
# Skip the main execution blocks (arg parsing, validation, recording loop).
if [[ "${WHISPER_STREAM_LIB:-0}" != "1" ]]; then

